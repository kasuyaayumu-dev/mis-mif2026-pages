# このファイルをコピーして .env を作成し、実際の値を入れる(.envはgit管理しない)
# cp .env.example .env

# OpenAI APIキー(絶対にコードやgitにコミットしない)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 使用モデル
OPENAI_MODEL=gpt-5.6-luna

# サーバーの待受ポート
PORT=9877

# CORSで許可するオリジン(STUDIOの公開サイトのドメイン)。カンマ区切りで複数指定可。
# 例: https://your-site.studio.site,https://your-custom-domain.com
ALLOWED_ORIGINS=https://your-site.studio.site

# 企画データの取得元(data/groups.json / groups.en.json を公開しているURLのベース)
DATA_BASE_URL=https://kasuyaayumu-dev.github.io/mis-mif2026-pages/data
